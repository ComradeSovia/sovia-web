model MusicWorkPlatform {
  id          String    @id @default(cuid())
  contentId   String
  platform    String
  platformId  String?
  title       String?
  description String?
  metadata    Json?
  work        MusicWork @relation(fields: [contentId], references: [contentId], onDelete: Cascade)

  @@unique([contentId, platform])
  @@map("music_work_platforms")
}
