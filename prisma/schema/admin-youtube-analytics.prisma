model AdminYoutubeAnalyticsSync {
  id        String   @id
  startedAt DateTime @default(now())
  syncedAt  DateTime?
  startDate String
  endDate   String
  videoCount Int     @default(0)
  status    String
  message   String?

  @@map("admin_youtube_analytics_syncs")
}

model AdminYoutubeVideoAnalyticsSnapshot {
  id                         String   @id @default(cuid())
  contentId                  String
  videoId                    String
  periodDays                 Int
  startDate                  String
  endDate                    String
  views                      Int      @default(0)
  estimatedMinutesWatched    Float?
  averageViewDuration        Float?
  averageViewPercentage      Float?
  subscribersGained          Int      @default(0)
  subscribersLost            Int      @default(0)
  likes                      Int      @default(0)
  comments                   Int      @default(0)
  shares                     Int      @default(0)
  impressions                Int?
  impressionClickThroughRate Float?
  syncedAt                   DateTime @default(now())
  work                       MusicWork @relation(fields: [contentId], references: [contentId], onDelete: Cascade)

  @@unique([videoId, periodDays, endDate])
  @@index([contentId])
  @@index([periodDays, endDate])
  @@map("admin_youtube_video_analytics_snapshots")
}

model AdminYoutubeVideoEarlyPerformanceSnapshot {
  id                      String    @id @default(cuid())
  contentId               String
  videoId                 String
  elapsedHours            Int
  granularity             String
  startDate               String
  endDate                 String
  views                   Int       @default(0)
  estimatedMinutesWatched Float?
  averageViewDuration     Float?
  averageViewPercentage   Float?
  subscribersGained       Int       @default(0)
  subscribersLost         Int       @default(0)
  impressions             Int?
  impressionClickThroughRate Float?
  likes                   Int       @default(0)
  comments                Int       @default(0)
  shares                  Int       @default(0)
  syncedAt                DateTime  @default(now())
  work                    MusicWork @relation(fields: [contentId], references: [contentId], onDelete: Cascade)

  @@unique([videoId, elapsedHours])
  @@index([contentId])
  @@index([elapsedHours])
  @@map("admin_youtube_video_early_performance_snapshots")
}

model AdminYoutubeVideoRetentionSnapshot {
  id                           String    @id @default(cuid())
  contentId                    String
  videoId                      String
  elapsedHours                 Int
  elapsedVideoTimePercent      Int
  startDate                    String
  endDate                      String
  audienceWatchRatio           Float
  relativeRetentionPerformance Float?
  syncedAt                     DateTime  @default(now())
  work                         MusicWork @relation(fields: [contentId], references: [contentId], onDelete: Cascade)

  @@unique([videoId, elapsedHours, elapsedVideoTimePercent])
  @@index([contentId, elapsedHours])
  @@map("admin_youtube_video_retention_snapshots")
}

model AdminYoutubeVideoReachDaily {
  id                         String    @id @default(cuid())
  contentId                  String
  videoId                    String
  date                       String
  impressions                Int
  impressionClickThroughRate Float?
  reportId                   String
  syncedAt                   DateTime  @default(now())
  work                       MusicWork @relation(fields: [contentId], references: [contentId], onDelete: Cascade)

  @@unique([videoId, date])
  @@index([contentId, date])
  @@map("admin_youtube_video_reach_daily")
}

model AdminYoutubeVideoRealtimeSnapshot {
  id              String    @id @default(cuid())
  contentId       String
  videoId         String
  views           Int
  likes           Int       @default(0)
  comments        Int       @default(0)
  observedAt      DateTime  @default(now())
  work            MusicWork @relation(fields: [contentId], references: [contentId], onDelete: Cascade)

  @@index([contentId, observedAt])
  @@index([videoId, observedAt])
  @@map("admin_youtube_video_realtime_snapshots")
}

model AdminYoutubeReportingImport {
  reportId  String   @id
  jobId     String
  startTime DateTime
  endTime   DateTime
  createdAt DateTime
  importedAt DateTime @default(now())
  rowCount  Int      @default(0)

  @@index([jobId, createdAt])
  @@map("admin_youtube_reporting_imports")
}

model AdminYoutubeVideoTrafficSourceSnapshot {
  id                      String    @id @default(cuid())
  contentId               String
  videoId                 String
  periodDays              Int
  startDate               String
  endDate                 String
  sourceType              String
  views                   Int       @default(0)
  estimatedMinutesWatched Float?
  engagedViews            Int       @default(0)
  syncedAt                DateTime  @default(now())
  work                    MusicWork @relation(fields: [contentId], references: [contentId], onDelete: Cascade)

  @@unique([videoId, periodDays, endDate, sourceType])
  @@index([contentId])
  @@index([periodDays, endDate])
  @@map("admin_youtube_video_traffic_source_snapshots")
}
