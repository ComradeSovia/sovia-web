generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model MusicWork {
  path        String   @id
  vid         String
  title       String
  original    String?
  u2bId       String?
  series      String?
  description String?
  lyrics      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("music_works")
}

model SoviaTestSubmission {
  id          String   @id @default(cuid())
  visitorId   String?
  fingerprint String?  @unique
  resultCode  String
  resultHash  String
  locale      String
  ageGroup    String
  gender      String
  scores      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([visitorId])
  @@index([resultCode])
  @@index([locale])
  @@map("sovia_test_submissions")
}
