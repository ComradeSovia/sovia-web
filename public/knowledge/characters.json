  "worldPolarizationTypes": [
    {
      "type": "prime",
      "symbol": "0",
      "description": "0 is the reference point: Sovia’s original world, home to the interdimensional broadcast station. All polarization readings are taken relative to this origin.",
      "boundary": "0"
    },
    {
      "type": "original",
      "symbol": "+",
      "description": "Along the positive real axis, a larger value marks a greater departure from Sovia’s original world and its established setting. Near 1, the character is almost entirely original. This direction includes official and fan-created original characters.",
      "boundary": "1"
    },
    {
      "type": "derivative",
      "symbol": "-",
      "description": "The negative real axis points toward other fictional works. At -1, the character comes entirely from another work; its origin belongs to that work’s world.",
      "boundary": "-1"
    },
    {
      "type": "realWorldOrigin",
      "symbol": "+i",
      "description": "Along the +i direction, a reading closer to 1i places the world of origin closer to the audience’s real world. The nearer it is to that boundary, the clearer the traces of reality in its origins. This reading describes origin; identity is recorded in the character’s profile.",
      "boundary": "1i"
    },
    {
      "type": "historicalInterpretation",
      "symbol": "-i",
      "description": "The negative imaginary axis leads into the historical record. At -1i, the arrival retains a fully faithful historical portrayal: a passage from actual history into Sovia’s world, recorded as fully historical time travel.",
      "boundary": "-1i"
    }
  ],
