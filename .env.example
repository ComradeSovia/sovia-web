# Admin auth:
# 1. If SOVIA_ADMIN_PASSWORD is set and non-empty, password login is used.
# 2. If SOVIA_ADMIN_PASSWORD is empty or missing, Google login is used when all
#    Google variables below are configured.
# 3. If neither mode is configured, admin access is disabled.
SOVIA_ADMIN_PASSWORD="change-me"

# Public base URL used for canonical URLs and OAuth redirect URIs.
# Local: http://localhost:3000
# Production: https://sovia.work
SITE_URL="http://localhost:3000"

# https://console.cloud.google.com/auth/clients
SOVIA_ADMIN_GOOGLE_CLIENT_ID="client-id"
SOVIA_ADMIN_GOOGLE_CLIENT_SECRET="client-secret"
SOVIA_ADMIN_GOOGLE_EMAIL="***@gmail.com"
SOVIA_ADMIN_GOOGLE_SUB=""
SOVIA_ADMIN_SESSION_SECRET="some-random-string"

# openai api key
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Read-only admin MCP endpoint for ChatGPT/Codex private usage.
# Endpoint: https://sovia.work/api/admin/mcp
# Use a long random value and send it as:
# Authorization: Bearer <SOVIA_ADMIN_MCP_API_KEY>
SOVIA_ADMIN_MCP_API_KEY="long-random-read-only-secret"
# Optional separate signing secret for ChatGPT MCP OAuth tokens. If omitted,
# SOVIA_ADMIN_SESSION_SECRET or SOVIA_ADMIN_MCP_API_KEY is used as fallback.
SOVIA_ADMIN_MCP_OAUTH_SECRET="another-long-random-oauth-secret"

# YouTube Data API write access.
# OAuth 2.0 client used by the admin Connect YouTube flow. Add these redirect
# URIs in Google Cloud: /admin/youtube/callback on local and production origins.
# Client ID example format:
# 123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
# The refresh token is obtained in the admin and encrypted in PostgreSQL.
# YouTube write and analytics read scopes:
# https://www.googleapis.com/auth/youtube.force-ssl
# https://www.googleapis.com/auth/yt-analytics.readonly
# https://www.googleapis.com/auth/youtube.readonly
YOUTUBE_DATA_API_CLIENT_ID="123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com"
YOUTUBE_DATA_API_CLIENT_SECRET="client-secret"
# Base64-encoded 32-byte key, for example generated with: openssl rand -base64 32
YOUTUBE_TOKEN_ENCRYPTION_KEY="base64-encoded-32-byte-key"

# Authorizes scheduled POST requests to /api/cron/* routes. Configure the same
# value as the CRON_SECRET GitHub Actions repository secret.
CRON_SECRET="another-long-random-secret"

# postgresql connection string
DATABASE_URL="postgresql://user:password@localhost:5432/sovia-web?schema=public"

# local postgresql settings for ssh port forwarding
# ssh -N -L 5432:127.0.0.1:5432 deploy@ip
